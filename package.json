{
  "name": "bubble_schedule",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bubbleschedule/frontend",
    "build": "npm run build --workspace=@bubbleschedule/frontend",
    "start": "npm run start --workspace=@bubbleschedule/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=@bubbleschedule/frontend",
    "deploy:firebase": "firebase deploy --only firestore"
  },
  "devDependencies": {
    "next": "16.4.6"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.9.6"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
